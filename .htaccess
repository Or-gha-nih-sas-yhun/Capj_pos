# ==============================================================================
# Root .htaccess - Forward requests to /public and protect application files
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive root files and directories
    RewriteRule ^(\.env|\.git|app|bootstrap|config|database|resources|routes|storage|tests|vendor) - [F,L,NC]

    # Forward all other requests to the public directory
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Block access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
